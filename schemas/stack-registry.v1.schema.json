{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/stack-registry.v1.schema.json",
  "title": "Starlight stack registry",
  "description": "Which agent runs where, on which model, with which tools. Every row cites repository files as evidence. Status follows the evidence rules in statusRules; scripts/check-stack-registry.mjs enforces them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "verifiedAt", "owner", "statusRules", "providers", "runtimes", "agentSpecs", "mcpServers", "deployments"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "owner": { "type": "string", "minLength": 1 },
    "statusRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live", "wired", "planned"],
      "properties": {
        "live": { "type": "string", "minLength": 1 },
        "wired": { "type": "string", "minLength": 1 },
        "planned": { "type": "string", "minLength": 1 }
      }
    },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
    "runtimes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runtime" } },
    "agentSpecs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/agentSpec" } },
    "mcpServers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mcpServer" } },
    "deployments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/deployment" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status": { "enum": ["live", "wired", "planned"] },
    "repoPath": { "type": "string", "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/@ -]*$" },
    "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoPath" } },
    "envVarName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "liveCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "observedAt", "httpStatus", "note"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "httpStatus": { "type": "integer" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "status", "surface", "evidence", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["model-lab", "model-host", "gateway", "voice", "search", "local-models"] },
        "status": { "$ref": "#/$defs/status" },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integration", "envVars"],
          "properties": {
            "integration": { "type": "string", "minLength": 1 },
            "package": { "type": "string", "minLength": 1 },
            "envVars": { "type": "array", "items": { "$ref": "#/$defs/envVarName" } }
          }
        },
        "models": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/paths" },
        "deployEvidence": { "$ref": "#/$defs/paths" },
        "liveCheck": { "$ref": "#/$defs/liveCheck" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "platform", "status", "evidence", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["local", "vercel", "cloudflare-workers", "gcp-cloud-run", "oci"] },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/paths" },
        "deployEvidence": { "$ref": "#/$defs/paths" },
        "liveCheck": { "$ref": "#/$defs/liveCheck" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "agentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "evidence", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/paths" },
        "validatedBy": { "$ref": "#/$defs/paths" },
        "deployEvidence": { "$ref": "#/$defs/paths" },
        "liveCheck": { "$ref": "#/$defs/liveCheck" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "transport", "runtime", "status", "entry", "tools", "evidence", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "transport": { "enum": ["stdio", "streamable-http", "http", "in-process"] },
        "runtime": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "status": { "$ref": "#/$defs/status" },
        "entry": { "$ref": "#/$defs/repoPath" },
        "package": { "type": "string", "minLength": 1 },
        "tools": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "evidence": { "$ref": "#/$defs/paths" },
        "deployEvidence": { "$ref": "#/$defs/paths" },
        "liveCheck": { "$ref": "#/$defs/liveCheck" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agent", "runtime", "modelRoute", "mcpServers", "skills", "status", "evidence", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["registered", "service-identity"] },
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        },
        "runtime": { "$ref": "#/$defs/id" },
        "modelRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "models", "calls"],
          "properties": {
            "provider": { "$ref": "#/$defs/id" },
            "via": { "$ref": "#/$defs/id" },
            "models": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "calls": { "type": "boolean" }
          }
        },
        "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/paths" },
        "deployEvidence": { "$ref": "#/$defs/paths" },
        "liveCheck": { "$ref": "#/$defs/liveCheck" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
